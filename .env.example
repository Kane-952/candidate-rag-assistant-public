## local: localhost + local outbox. production: HTTPS + SMTP, DEBUG=false.
APP_ENV=local
DEBUG=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
MODEL_DEVICE=cpu
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
ENABLE_RERANKER=true
MAX_PENDING_CHATS=4
CHUNK_SIZE=450
CHUNK_OVERLAP=80
BM25_TOP_K=12
DENSE_TOP_K=12
HYBRID_TOP_K=12
RERANK_TOP_K=4
RRF_K=60
# 初始启发式阈值，必须用自己的 KB / 标注问题校准。
MIN_DENSE_SCORE=0.45
# 兼容旧配置；当前重排模式不再用此值直接拒答。
MIN_RERANK_SCORE=0.20
MIN_ANSWERABILITY_CONFIDENCE=0.80
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# DeepSeek 可设 disabled；其他服务商保留 default，不发送扩展参数。
LLM_THINKING_MODE=default

# 任意合法邮箱可申请一次性登录链接；公开部署必须使用 HTTPS + SMTP。
# 仅这些经过邮箱验证的管理员可以访问 /inspector；留空即关闭调试页。
INSPECTOR_ADMIN_EMAILS=[]
AUTH_EMAIL_COOLDOWN_SECONDS=60
AUTH_IP_WINDOW_SECONDS=900
AUTH_IP_MAX_REQUESTS=20
AUTH_PUBLIC_URL=http://127.0.0.1:8000
AUTH_DELIVERY=local
AUTH_SESSION_TTL_SECONDS=86400
AUTH_LINK_TTL_SECONDS=600
# QQ SMTP 示例：启用时将 AUTH_DELIVERY 改为 smtp，并在未跟踪的 .env 或
# 服务器 /etc/candidate-rag-assistant.env 中填入实际邮箱和 SMTP 授权码。
# 不要填写 QQ 登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_FROM=your@qq.com
SMTP_SECURITY=ssl

# Production: set APP_ENV=production, AUTH_PUBLIC_URL=https://your-domain-or-ip,
# AUTH_DELIVERY=smtp and actual SMTP credentials in a protected server environment
# file. Never copy this local configuration into production as-is. Use persistent
# paths for AUTH_DB and FEEDBACK_DB.
